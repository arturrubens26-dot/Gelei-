# Copie para .env e preencha. O .env NÃO vai para o Git.
# O servidor recusa subir se DATABASE_URL ou SESSION_SECRET estiverem ausentes/fracos.

# Conexão PostgreSQL. Em desenvolvimento local: rode `npm run db:dev` (Postgres embutido do Prisma)
# e cole aqui a URL "postgres://..." que ele mostrar. Em produção: Neon, Supabase, RDS, etc.
DATABASE_URL="postgres://USUARIO:SENHA@HOST:5432/geleio"

# Conexões simultâneas com o banco (padrão 10).
# SÓ no desenvolvimento local com o Postgres embutido (`npm run db:dev`): descomente e use 1,
# porque ele executa uma consulta por vez e perde vagas de conexão (veja o README, "Banco local
# sem vagas"); com 1, o pool também fecha a conexão ociosa em 500 ms. Em produção deixe comentado
# (ou 2 a 5 atrás de pooler).
# DATABASE_POOL_MAX="1"

# Assina a sessão (JWT). Mínimo 32 caracteres, aleatório e secreto.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Usuário admin criado por `npm run db:seed`.
# Em produção: e-mail próprio e senha de 12+ caracteres são obrigatórios.
# O seed NÃO promove uma conta comum já existente a admin: use um e-mail que ainda não exista.
SEED_ADMIN_EMAIL="admin@geleio.local"
SEED_ADMIN_NAME="Administrador Geleiô"
SEED_ADMIN_PASSWORD=""

# Pagamento simulado (PIX de demonstração). Para desenvolver/demonstrar, use "true".
# Com ele ligado o cliente consegue marcar o próprio pedido como pago, então em PRODUÇÃO
# (NODE_ENV=production) o servidor recusa subir com "true" a não ser que APP_ENV="demo".
PAGAMENTOS_SIMULADOS="false"
# APP_ENV="demo"   # só para uma demonstração publicada de propósito, com pagamentos de mentira

# Endereço oficial do site (usado para conferir a origem das requisições). Ex.: https://www.geleio.com.br
# APP_URL="https://www.geleio.com.br"

# Nome do cabeçalho de IP que o SEU proxy/CDN confiável define ou sobrescreve, para ativar limites de
# taxa por IP: "x-real-ip", "cf-connecting-ip" (Cloudflare), "x-nf-client-connection-ip" (Netlify) ou
# "x-forwarded-for" (vale o último valor).
# Se o servidor ficar exposto direto à internet, deixe em branco: cabeçalhos de IP viriam do próprio
# cliente e seriam forjáveis (o login continua limitado por conta).
# IP_HEADER_CONFIAVEL="x-real-ip"
