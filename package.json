{
  "name": "geleio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:dev": "prisma dev --name geleio --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:producao": "node scripts/migrar-producao.mjs",
    "db:seed": "prisma db seed",
    "admin:senha": "tsx scripts/redefinir-senha-admin.ts",
    "dados:salvar": "node scripts/dados.mjs salvar --commit",
    "dados:salvar:producao": "node scripts/dados.mjs salvar --producao --commit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test testes/*.test.ts",
    "test:pagamento": "node testes/infinitepay-e2e.mjs",
    "ensaio:infinitepay": "tsx scripts/ensaio-infinitepay.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cep-promise": "^4.4.1",
    "framer-motion": "13.4.6",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
