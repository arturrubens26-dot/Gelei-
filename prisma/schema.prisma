// Schema do banco da Geleiô (PostgreSQL).
// Colunas no banco seguem snake_case (password_hash, is_admin, ...); no código
// usamos camelCase via @map. A URL de conexão fica em prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

/// Onde a venda aconteceu: no site (ONLINE) ou lançada pelo admin (PRESENCIAL: feira, balcão).
enum OrderChannel {
  ONLINE
  PRESENCIAL
}

/// Forma de pagamento informada na venda presencial (rótulos em src/lib/vendas.ts).
enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  OUTRO
}

/// Clientes e administradores. `isAdmin` nunca deve ser definido a partir de entrada do usuário.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  nome         String
  isAdmin      Boolean   @default(false) @map("is_admin")
  createdAt    DateTime  @default(now()) @map("created_at")
  addresses    Address[]
  orders       Order[]   @relation("PedidosDoCliente")
  /// Vendas presenciais que este admin lançou (auditoria).
  vendasRegistradas Order[] @relation("VendasRegistradas")
  /// Pedidos/vendas que este admin cancelou ou estornou (auditoria).
  pedidosCancelados Order[] @relation("PedidosCancelados")
  expenses     Expense[]
  /// Produções e ajustes de estoque que este admin lançou (auditoria).
  producoesRegistradas Producao[]      @relation("ProducoesRegistradas")
  ajustesRegistrados   AjusteEstoque[] @relation("AjustesRegistrados")

  @@map("users")
}

model Product {
  id         String      @id @default(cuid())
  nome       String
  descricao  String
  /// Preço em reais (ex.: 24.90).
  preco      Decimal     @db.Decimal(10, 2)
  imagemUrl  String      @map("imagem_url")
  /// Peso de cada unidade, em gramas (ex.: 250). Usado no cálculo de frete.
  pesoGramas Int         @map("peso_gramas")
  /// Aparece na loja? Produto com vendas ou produções não pode ser excluído (o histórico aponta
  /// para ele): o admin o oculta da loja.
  ativo      Boolean     @default(true)
  orderItems OrderItem[]
  producoes  Producao[]
  fotos      ProdutoFoto[]
  /// Potes deste sabor vendidos dentro de kits (a venda avulsa fica em orderItems).
  kitSabores OrderKitSabor[]

  @@map("products")
}

/// Foto enviada pelo painel (a Netlify não guarda arquivos enviados, então a imagem fica no banco).
/// Servida em /fotos/<id>; cada foto nova ganha outro id, então o endereço pode ficar em cache para sempre.
model ProdutoFoto {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  /// image/jpeg, image/png ou image/webp (conferido pelos primeiros bytes do arquivo).
  tipo      String   @db.VarChar(20)
  dados     Bytes
  criadoEm  DateTime @default(now()) @map("criado_em")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("produto_fotos")
}

model Address {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  cep         String  @db.VarChar(8)
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String  @db.Char(2)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id          String      @id @default(cuid())
  /// Cliente. Obrigatório no pedido ONLINE (CHECK no banco); na venda PRESENCIAL pode faltar.
  userId      String?     @map("user_id")
  /// Endereço de entrega. Obrigatório no ONLINE (CHECK no banco); a venda presencial não tem entrega.
  /// `Restrict` impede apagar um endereço que já tem pedidos.
  addressId   String?     @map("address_id")
  status      OrderStatus @default(PENDENTE)
  canal       OrderChannel @default(ONLINE)
  /// Total cobrado = soma dos itens + deliveryFee (0 na venda presencial).
  total       Decimal     @db.Decimal(10, 2)
  deliveryFee Decimal     @db.Decimal(10, 2) @map("delivery_fee")
  /// Data da venda. Na presencial lançada depois, é o dia informado (meio-dia de Brasília).
  createdAt   DateTime    @default(now()) @map("created_at")
  /// Chave enviada pelo cliente (cabeçalho Idempotency-Key): reenviar a mesma chave devolve este pedido
  /// em vez de criar outro (duplo clique, retry de rede). NULL é permitido várias vezes.
  idempotencyKey String?  @map("idempotency_key")
  /// Venda presencial: forma de pagamento, nome digitado pelo admin e observação (ex.: "Feira do bairro").
  formaPagamento PaymentMethod? @map("forma_pagamento")
  clienteNome    String?        @map("cliente_nome") @db.VarChar(100)
  observacao     String?        @db.VarChar(300)
  /// Admin que lançou a venda presencial. SetNull: a venda continua no histórico se a conta sair.
  registradoPorId String?       @map("registrado_por_id")
  /// Quando a venda presencial foi lançada no painel (o createdAt pode ser de outro dia: venda retroativa).
  lancadoEm      DateTime?      @map("lancado_em")
  /// Quem cancelou/estornou e quando (qualquer canal). SetNull: o registro fica se a conta sair.
  canceladoEm    DateTime?      @map("cancelado_em")
  canceladoPorId String?        @map("cancelado_por_id")
  user        User?       @relation("PedidosDoCliente", fields: [userId], references: [id], onDelete: Restrict)
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: Restrict)
  registradoPor User?     @relation("VendasRegistradas", fields: [registradoPorId], references: [id], onDelete: SetNull)
  canceladoPor  User?     @relation("PedidosCancelados", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  /// Caixas de kit do pedido (os potes avulsos continuam em `items`).
  kits        OrderKit[]
  pagamentos  Pagamento[]

  @@unique([userId, idempotencyKey])
  // Idempotência da venda presencial (por admin). Pedidos online têm registradoPorId nulo e não colidem.
  @@unique([registradoPorId, idempotencyKey])
  @@index([userId])
  @@index([addressId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([canal, createdAt])
  @@index([canceladoPorId])
  @@map("orders")
}

/// Situação de uma cobrança PIX (traduzida do status do gateway em src/lib/mercadopago-regras.ts).
enum PaymentStatus {
  PENDENTE
  APROVADO
  /// Expirou sem pagamento ou foi cancelada (pedido cancelado, PIX substituído por outro).
  CANCELADO
  RECUSADO
  /// Devolvida ao cliente (estorno ou contestação).
  ESTORNADO
}

/// Cobrança PIX de um pedido online. Um pedido pode ter várias: o PIX expira e o cliente gera outro.
/// O pedido só vira PAGO quando o servidor CONSULTA o gateway e o valor confere (o aviso do gateway
/// é só o gatilho da consulta). Ver src/lib/pagamentos.ts.
model Pagamento {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  /// "mercadopago" ou "simulado" (demonstração local).
  gateway           String        @db.VarChar(20)
  /// Id da cobrança no gateway (no Mercado Pago, o id do pagamento).
  referenciaExterna String        @map("referencia_externa") @db.VarChar(64)
  status            PaymentStatus @default(PENDENTE)
  /// Status cru do gateway na última consulta (ex.: "pending", "approved"), para conferência.
  statusGateway     String?       @map("status_gateway") @db.VarChar(40)
  /// Valor cobrado: o total do pedido quando a cobrança foi aberta.
  valor             Decimal       @db.Decimal(10, 2)
  /// Código "PIX copia e cola" e a imagem do QR Code (PNG em base64), como o gateway devolveu.
  copiaECola        String        @map("copia_e_cola")
  qrCodeBase64      String?       @map("qr_code_base64")
  expiraEm          DateTime      @map("expira_em")
  criadoEm          DateTime      @default(now()) @map("criado_em")
  /// Última consulta ao gateway: limita quantas vezes a tela do cliente faz o servidor perguntar.
  consultadoEm      DateTime?     @map("consultado_em")
  aprovadoEm        DateTime?     @map("aprovado_em")
  /// Restrict: pedido com cobrança não é apagado (o histórico do dinheiro fica).
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([gateway, referenciaExterna])
  @@index([orderId])
  @@map("pagamentos")
}

/// Categorias de despesa (rótulos em português em src/lib/despesas.ts).
enum ExpenseCategory {
  INGREDIENTES
  EMBALAGENS
  ROTULOS
  ENTREGA
  MARKETING
  EQUIPAMENTOS
  TAXAS
  OUTROS
}

/// Unidade da quantidade comprada (un, kg, g, L, mL, pacote, caixa, metro).
enum ExpenseUnit {
  UN
  KG
  G
  L
  ML
  PACOTE
  CAIXA
  METRO
}

/// Tudo o que a loja gasta (frutas, potes, adesivos, frete…), lançado pelo admin em /admin/expenses.
model Expense {
  id          String          @id @default(cuid())
  descricao   String          @db.VarChar(120)
  categoria   ExpenseCategory
  /// Quantidade comprada (ex.: 50 adesivos, 2,5 kg de açúcar). Até 3 casas decimais.
  quantidade  Decimal         @db.Decimal(12, 3)
  unidade     ExpenseUnit
  /// Quanto foi pago no total, em reais (ex.: 20.00). Custo unitário = valorTotal / quantidade.
  valorTotal  Decimal         @db.Decimal(10, 2) @map("valor_total")
  /// Dia da compra (sem hora).
  data        DateTime        @db.Date
  fornecedor  String?         @db.VarChar(80)
  observacao  String?         @db.VarChar(300)
  createdAt   DateTime        @default(now()) @map("created_at")
  /// Admin que lançou. SetNull: a despesa continua no histórico se a conta for removida.
  criadoPorId String?         @map("criado_por_id")
  criadoPor   User?           @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  /// Compra de insumo: liga a despesa ao estoque da produção (opcional).
  insumoId       String?  @map("insumo_id")
  /// Quanto entrou no estoque, na unidade do insumo (2,155 kg de maçã → 2155 g).
  quantidadeBase Decimal? @db.Decimal(14, 3) @map("quantidade_base")
  /// Restrict: insumo com compra não se apaga (desativa).
  insumo         Insumo?  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([data])
  @@index([criadoPorId])
  @@index([insumoId])
  @@map("expenses")
}

/// Unidade em que o estoque e o custo de um insumo são contados.
enum InsumoUnit {
  G
  ML
  UN
}

/// O que vai dentro do pote (ingrediente) ou o que o embala (pote, tampa, rótulo, lacre).
enum InsumoTipo {
  INGREDIENTE
  EMBALAGEM
}

/// Ingredientes e embalagens da produção (/admin/production). Estoque = compras − usos + ajustes.
model Insumo {
  id              String          @id @default(cuid())
  nome            String          @unique @db.VarChar(80)
  tipo            InsumoTipo
  unidade         InsumoUnit
  /// Avisar quando a sobra ficar abaixo disto (na unidade do insumo).
  estoqueMinimo   Decimal?        @db.Decimal(14, 3) @map("estoque_minimo")
  /// false: não controla estoque (limão do quintal, água): entra na produção com custo informado.
  controlaEstoque Boolean         @default(true) @map("controla_estoque")
  ativo           Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  compras         Expense[]
  usos            ProducaoItem[]
  ajustes         AjusteEstoque[]

  @@map("insumos")
}

/// Um lote de geleia: o que entrou, quanto custou e quantos potes rendeu.
model Producao {
  id          String          @id @default(cuid())
  /// Dia da produção (sem hora).
  data        DateTime        @db.Date
  /// Sabor do catálogo (opcional: receita de teste). Restrict: sabor com produção não se apaga.
  productId   String?         @map("product_id")
  /// Nome da receita/lote (ex.: "Receita 1").
  nome        String          @db.VarChar(80)
  /// Quantos potes renderam.
  potes       Int
  observacao  String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at")
  criadoPorId String?         @map("criado_por_id")
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  criadoPor   User?           @relation("ProducoesRegistradas", fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens       ProducaoItem[]
  custos      ProducaoCusto[]

  @@index([data])
  @@index([productId])
  @@index([criadoPorId])
  @@map("producoes")
}

/// Ingrediente ou embalagem usado num lote.
model ProducaoItem {
  id            String   @id @default(cuid())
  producaoId    String   @map("producao_id")
  insumoId      String   @map("insumo_id")
  /// Quantidade usada, na unidade do insumo.
  quantidade    Decimal  @db.Decimal(14, 3)
  /// R$ por unidade do insumo no dia da produção (custo médio ou o informado): compras depois não mudam o lote.
  custoUnitario Decimal  @db.Decimal(16, 6) @map("custo_unitario")
  producao      Producao @relation(fields: [producaoId], references: [id], onDelete: Cascade)
  insumo        Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([producaoId])
  @@index([insumoId])
  @@map("producao_itens")
}

/// Custo do lote que não é insumo de estoque: gás, energia, água, mão de obra.
model ProducaoCusto {
  id         String   @id @default(cuid())
  producaoId String   @map("producao_id")
  descricao  String   @db.VarChar(60)
  valor      Decimal  @db.Decimal(10, 2)
  producao   Producao @relation(fields: [producaoId], references: [id], onDelete: Cascade)

  @@index([producaoId])
  @@map("producao_custos")
}

/// Correção manual do estoque: perda, estragou, recontagem (positivo entra, negativo sai).
model AjusteEstoque {
  id          String   @id @default(cuid())
  insumoId    String   @map("insumo_id")
  quantidade  Decimal  @db.Decimal(14, 3)
  motivo      String   @db.VarChar(120)
  data        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  criadoPorId String?  @map("criado_por_id")
  insumo      Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  criadoPor   User?    @relation("AjustesRegistrados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([insumoId])
  @@map("ajustes_estoque")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  quantidade    Int
  /// Preço do produto no momento da compra (não muda se o preço do produto mudar depois).
  precoUnitario Decimal @db.Decimal(10, 2) @map("preco_unitario")
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Kit de presente (caixa com N potes à escolha). Não tem foto: a loja desenha a caixa com as fotos
/// REAIS dos sabores escolhidos (os mockups recebidos têm erros de marca, peso e sabor).
model Kit {
  id              String     @id
  nome            String     @db.VarChar(80)
  descricao       String     @db.VarChar(300)
  /// Preço de UMA caixa, em reais (padrão 40.00). Configurado no painel.
  preco           Decimal    @db.Decimal(10, 2)
  /// Quantos potes vão na caixa (3). Não editável no painel na v1.
  potes           Int        @default(3)
  /// Peso da caixa vazia, somado ao dos potes no frete.
  pesoCaixaGramas Int        @map("peso_caixa_gramas")
  /// Aparece na loja? Nasce oculto: a dona confere o preço e ativa no painel.
  ativo           Boolean    @default(false)
  pedidos         OrderKit[]

  @@map("kits")
}

/// Caixas de um pedido. Mesma composição = uma linha com quantidade > 1.
model OrderKit {
  id            String          @id @default(cuid())
  orderId       String          @map("order_id")
  kitId         String          @map("kit_id")
  /// Quantas caixas com esta composição.
  quantidade    Int
  /// Preço de UMA caixa no momento da compra (congelado: mudar o preço do kit não muda pedidos antigos).
  precoUnitario Decimal         @db.Decimal(10, 2) @map("preco_unitario")
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict: kit com vendas não se apaga (oculta-se).
  kit           Kit             @relation(fields: [kitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sabores       OrderKitSabor[]

  @@index([orderId])
  @@index([kitId])
  @@map("order_kits")
}

/// Composição: potes de cada sabor em CADA caixa. Total de potes = quantidade × orderKit.quantidade.
model OrderKitSabor {
  id           String   @id @default(cuid())
  orderKitId   String   @map("order_kit_id")
  productId    String   @map("product_id")
  /// Potes deste sabor em UMA caixa.
  quantidade   Int
  /// Preço avulso do sabor no dia (congelado): base do rateio e do "desconto dado".
  precoAvulso  Decimal  @db.Decimal(10, 2) @map("preco_avulso")
  /// Parte do preço de UMA caixa atribuída a este sabor (todos os potes dele). Soma = precoUnitario.
  valorRateado Decimal  @db.Decimal(10, 2) @map("valor_rateado")
  orderKit     OrderKit @relation(fields: [orderKitId], references: [id], onDelete: Cascade)
  /// Restrict: sabor vendido em kit não se apaga (oculta-se), como na venda avulsa.
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderKitId, productId])
  @@index([productId])
  @@map("order_kit_sabores")
}
