// Schema do banco da Geleiô (PostgreSQL).
// Colunas no banco seguem snake_case (password_hash, is_admin, ...); no código
// usamos camelCase via @map. A URL de conexão fica em prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

/// Onde a venda aconteceu: no site (ONLINE) ou lançada pelo admin (PRESENCIAL: feira, balcão).
enum OrderChannel {
  ONLINE
  PRESENCIAL
}

/// Pedido online: entrega em Teresina (com taxa) ou retirada na loja (sem endereço e sem frete).
/// A venda presencial não tem (NULL). Mesma ordem do ramo das lembrancinhas, que usa o mesmo tipo.
enum ModoEntrega {
  RETIRADA
  ENTREGA
}

/// Forma de pagamento informada na venda presencial (rótulos em src/lib/vendas.ts).
enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  OUTRO
}

/// Clientes e administradores. `isAdmin` nunca deve ser definido a partir de entrada do usuário.
model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  passwordHash          String               @map("password_hash")
  nome                  String
  isAdmin               Boolean              @default(false) @map("is_admin")
  createdAt             DateTime             @default(now()) @map("created_at")
  addresses             Address[]
  orders                Order[]              @relation("PedidosDoCliente")
  /// Vendas presenciais que este admin lançou (auditoria).
  vendasRegistradas     Order[]              @relation("VendasRegistradas")
  /// Pedidos/vendas que este admin cancelou ou estornou (auditoria).
  pedidosCancelados     Order[]              @relation("PedidosCancelados")
  expenses              Expense[]
  /// Produções e ajustes de estoque que este admin lançou (auditoria).
  producoesRegistradas  Producao[]           @relation("ProducoesRegistradas")
  ajustesRegistrados    AjusteEstoque[]      @relation("AjustesRegistrados")
  /// Último WhatsApp informado num pedido (só dígitos, com DDD): pré-preenche a próxima compra.
  telefone              String?              @db.VarChar(11)
  /// Admin que mudou a configuração da loja por último (auditoria).
  configLojaAtualizada  ConfigLoja[]         @relation("ConfigLojaAtualizadaPor")
  /// Sobe a cada troca de senha: sessões com versão antiga (claim "v" do JWT) deixam de valer.
  sessaoVersao          Int                  @default(0) @map("sessao_versao")
  /// Pedidos de redefinição de senha desta conta.
  redefinicoes          RedefinicaoSenha[]   @relation("RedefinicoesDaConta")
  /// Links de redefinição que este admin gerou no painel (auditoria).
  linksSenhaGerados     RedefinicaoSenha[]   @relation("LinksSenhaGerados")
  /// Encomendas de lembrancinhas desta cliente.
  encomendas            Encomenda[]          @relation("EncomendasDoCliente")
  /// Restantes de encomenda recebidos fora do site que este admin registrou (auditoria, decisão D8).
  restantesRegistrados  Encomenda[]          @relation("RestantesRegistrados")
  entradasRegistradas   Encomenda[]          @relation("EntradasRegistradas")
  /// Devoluções de encomenda que este admin marcou como feitas (auditoria).
  devolucoesRegistradas EncomendaDevolucao[] @relation("DevolucoesRegistradas")

  @@map("users")
}

model Product {
  id               String          @id @default(cuid())
  nome             String
  descricao        String
  /// Preço em reais (ex.: 24.90).
  preco            Decimal         @db.Decimal(10, 2)
  imagemUrl        String          @map("imagem_url")
  /// Peso de cada unidade, em gramas (ex.: 250). Usado no cálculo de frete.
  pesoGramas       Int             @map("peso_gramas")
  /// Aparece na loja? Produto com vendas ou produções não pode ser excluído (o histórico aponta
  /// para ele): o admin o oculta da loja.
  ativo            Boolean         @default(true)
  /// Pode entrar no Kit Presente? Só os potes do tamanho padrão: um pote maior ou mais caro dentro
  /// da caixa sairia com desconto grande demais. Produto novo nasce FORA do kit (a dona marca no
  /// painel); o servidor recusa (400) caixa com sabor desmarcado.
  permitidoEmKit   Boolean         @default(false) @map("permitido_em_kit")
  /// Verso da foto: "Harmoniza com" (até 4 itens de 40 caracteres; CHECK no banco). Editável no painel.
  harmonizacoes    String[]        @default([])
  /// Verso da foto: "Por que você vai gostar" (até 3 itens de 70). Só sabor, textura, cor e uso:
  /// nada de alegação de saúde (o painel avisa).
  destaques        String[]        @default([])
  orderItems       OrderItem[]
  producoes        Producao[]
  fotos            ProdutoFoto[]
  /// Potes deste sabor vendidos dentro de kits (a venda avulsa fica em orderItems).
  kitSabores       OrderKitSabor[]
  /// Este sabor existe em potinho mini de 40 ml (lembrancinhas)? O mini é um formato de um sabor que
  /// já existe: disponível = `ativo && disponivelEmMini`, então ocultar o sabor oculta também o mini.
  /// Nasce DESMARCADO (a dona marca no painel).
  disponivelEmMini Boolean         @default(false) @map("disponivel_em_mini")
  /// Potinhos mini deste sabor em encomendas de lembrancinhas.
  encomendaItens   EncomendaItem[]

  @@map("products")
}

/// Foto enviada pelo painel (a Netlify não guarda arquivos enviados, então a imagem fica no banco).
/// Servida em /fotos/<id>; cada foto nova ganha outro id, então o endereço pode ficar em cache para sempre.
model ProdutoFoto {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  /// image/jpeg, image/png ou image/webp (conferido pelos primeiros bytes do arquivo).
  tipo      String   @db.VarChar(20)
  dados     Bytes
  criadoEm  DateTime @default(now()) @map("criado_em")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("produto_fotos")
}

model Address {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  cep         String      @db.VarChar(8)
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String      @db.Char(2)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  encomendas  Encomenda[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String         @id @default(cuid())
  /// Cliente. Obrigatório no pedido ONLINE (CHECK no banco); na venda PRESENCIAL pode faltar.
  userId          String?        @map("user_id")
  /// Endereço de entrega. Obrigatório no ONLINE (CHECK no banco); a venda presencial não tem entrega.
  /// `Restrict` impede apagar um endereço que já tem pedidos.
  addressId       String?        @map("address_id")
  status          OrderStatus    @default(PENDENTE)
  canal           OrderChannel   @default(ONLINE)
  /// Total cobrado = soma dos itens + deliveryFee (0 na venda presencial).
  total           Decimal        @db.Decimal(10, 2)
  deliveryFee     Decimal        @map("delivery_fee") @db.Decimal(10, 2)
  /// Data da venda. Na presencial lançada depois, é o dia informado (meio-dia de Brasília).
  createdAt       DateTime       @default(now()) @map("created_at")
  /// Chave enviada pelo cliente (cabeçalho Idempotency-Key): reenviar a mesma chave devolve este pedido
  /// em vez de criar outro (duplo clique, retry de rede). NULL é permitido várias vezes.
  idempotencyKey  String?        @map("idempotency_key")
  /// Venda presencial: forma de pagamento, nome digitado pelo admin e observação (ex.: "Feira do bairro").
  formaPagamento  PaymentMethod? @map("forma_pagamento")
  clienteNome     String?        @map("cliente_nome") @db.VarChar(100)
  observacao      String?        @db.VarChar(300)
  /// Admin que lançou a venda presencial. SetNull: a venda continua no histórico se a conta sair.
  registradoPorId String?        @map("registrado_por_id")
  /// Quando a venda presencial foi lançada no painel (o createdAt pode ser de outro dia: venda retroativa).
  lancadoEm       DateTime?      @map("lancado_em")
  /// Quem cancelou/estornou e quando (qualquer canal). SetNull: o registro fica se a conta sair.
  canceladoEm     DateTime?      @map("cancelado_em")
  canceladoPorId  String?        @map("cancelado_por_id")
  /// Pedido online: ENTREGA (endereço obrigatório) ou RETIRADA (sem endereço, frete 0). NULL só na
  /// venda presencial (CHECK orders_canal_coerente).
  modoEntrega     ModoEntrega?   @map("modo_entrega")
  /// WhatsApp da cliente (só dígitos, com DDD; obrigatório nos pedidos online novos). NULL nos
  /// pedidos de antes desta versão e na venda presencial.
  telefone        String?        @db.VarChar(11)
  user            User?          @relation("PedidosDoCliente", fields: [userId], references: [id], onDelete: Restrict)
  address         Address?       @relation(fields: [addressId], references: [id], onDelete: Restrict)
  registradoPor   User?          @relation("VendasRegistradas", fields: [registradoPorId], references: [id], onDelete: SetNull)
  canceladoPor    User?          @relation("PedidosCancelados", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  /// Caixas de kit do pedido (os potes avulsos continuam em `items`).
  kits            OrderKit[]
  pagamentos      Pagamento[]

  @@unique([userId, idempotencyKey])
  // Idempotência da venda presencial (por admin). Pedidos online têm registradoPorId nulo e não colidem.
  @@unique([registradoPorId, idempotencyKey])
  @@index([userId])
  @@index([addressId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([canal, createdAt])
  @@index([canceladoPorId])
  @@map("orders")
}

/// Situação de uma cobrança, do nosso lado (src/lib/pagamentos-regras.ts).
enum PaymentStatus {
  PENDENTE
  APROVADO
  /// Venceu sem pagamento ou foi encerrada no nosso banco (pedido cancelado, link substituído). Na
  /// InfinitePay o link ainda aceita pagamento até o valid_until: a confirmação vale também daqui.
  CANCELADO
  RECUSADO
  /// Devolvida à cliente (estorno pelo app da InfinitePay).
  ESTORNADO
}

/// Cobrança de um pedido online OU de uma parcela de encomenda de lembrancinhas: um link do checkout
/// da InfinitePay (PIX ou cartão até 12x). Cada pedido ou parcela pode ter várias: o link vence em
/// 60 min e a cliente abre outro. Só vale como paga quando ESTE servidor confere a transação no
/// payment_check com a própria chave (o aviso e o retorno do navegador só disparam a conferência).
/// Uma tabela só para os dois: o UNIQUE(gateway, transacao_nsu) vale entre pedidos E encomendas, e
/// uma transação nunca quita duas cobranças. O "alvo" é exatamente um de `orderId` e `encomendaId`
/// (CHECK `pagamentos_alvo`), e a encomenda sempre com a parcela. Ver src/lib/pagamentos.ts.
model Pagamento {
  id                String               @id @default(cuid())
  /// Alvo pedido (nulo na cobrança de encomenda).
  orderId           String?              @map("order_id")
  /// Alvo encomenda de lembrancinhas, com a parcela (ENTRADA ou RESTANTE). Nulos na cobrança de pedido.
  encomendaId       String?              @map("encomenda_id")
  parcela           ParcelaEncomenda?
  /// "infinitepay" ou "simulado" (demonstração local).
  gateway           String               @db.VarChar(20)
  /// order_nsu enviado à InfinitePay, um por tentativa: ped-<pedidoId>-<n>, ou
  /// enc-<encomendaId>-<ENTRADA|RESTANTE>-<n> (CHECK: confere com a encomenda e a parcela da linha).
  referenciaExterna String               @map("referencia_externa") @db.VarChar(64)
  status            PaymentStatus        @default(PENDENTE)
  /// O que a última conferência disse (ex.: "pago", "nao-pago", "divergente:valor"), para conferência manual.
  statusGateway     String?              @map("status_gateway") @db.VarChar(40)
  /// Valor cobrado: o total do pedido quando o link foi aberto.
  valor             Decimal              @db.Decimal(10, 2)
  /// Link do checkout hospedado (null no simulado). Só https em *.infinitepay.io.
  checkoutUrl       String?              @map("checkout_url") @db.VarChar(500)
  /// Slug da fatura: da resposta de /links, se vier; senão, do candidato CONFIRMADO.
  faturaSlug        String?              @map("fatura_slug") @db.VarChar(100)
  /// Só depois do payment_check aprovado. UNIQUE: a mesma transação nunca quita duas cobranças.
  transacaoNsu      String?              @map("transacao_nsu") @db.VarChar(100)
  /// Último candidato recebido (aviso com token ou retorno da dona do pedido), ainda NÃO conferido.
  avisoTransacaoNsu String?              @map("aviso_transacao_nsu") @db.VarChar(100)
  avisoSlug         String?              @map("aviso_slug") @db.VarChar(100)
  avisadoEm         DateTime?            @map("avisado_em")
  /// A dona do pedido voltou da InfinitePay por esta cobrança (retorno do navegador): segura a tela em
  /// "confirmando" e bloqueia link novo por 30 min. O retorno também confere a transação no
  /// payment_check (com o canário de amarração) e pode confirmar; recusado, só esta hora fica gravada.
  retornoEm         DateTime?            @map("retorno_em")
  /// "pix" ou "credit_card"; parcelas de 1 a 12; valor pago (com os juros do parcelado) em reais.
  metodo            String?              @db.VarChar(20)
  parcelas          Int?
  valorPago         Decimal?             @map("valor_pago") @db.Decimal(10, 2)
  /// Comprovante da InfinitePay (só https em *.infinitepay.io).
  comprovanteUrl    String?              @map("comprovante_url") @db.VarChar(500)
  expiraEm          DateTime             @map("expira_em")
  criadoEm          DateTime             @default(now()) @map("criado_em")
  /// Última conferência no gateway: limita quantas vezes a tela da cliente faz o servidor perguntar.
  consultadoEm      DateTime?            @map("consultado_em")
  aprovadoEm        DateTime?            @map("aprovado_em")
  /// Restrict: pedido ou encomenda com cobrança não é apagado (o histórico do dinheiro fica).
  order             Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  encomenda         Encomenda?           @relation(fields: [encomendaId], references: [id], onDelete: Restrict)
  /// Devoluções de encomenda originadas por esta cobrança (paga tarde ou em duplicidade).
  devolucoes        EncomendaDevolucao[]

  @@unique([gateway, referenciaExterna])
  @@unique([gateway, transacaoNsu])
  @@index([orderId])
  @@index([encomendaId, parcela])
  @@map("pagamentos")
}

/// Categorias de despesa (rótulos em português em src/lib/despesas.ts).
enum ExpenseCategory {
  INGREDIENTES
  EMBALAGENS
  ROTULOS
  ENTREGA
  MARKETING
  EQUIPAMENTOS
  TAXAS
  OUTROS
}

/// Unidade da quantidade comprada (un, kg, g, L, mL, pacote, caixa, metro).
enum ExpenseUnit {
  UN
  KG
  G
  L
  ML
  PACOTE
  CAIXA
  METRO
}

/// Tudo o que a loja gasta (frutas, potes, adesivos, frete…), lançado pelo admin em /admin/expenses.
model Expense {
  id             String          @id @default(cuid())
  descricao      String          @db.VarChar(120)
  categoria      ExpenseCategory
  /// Quantidade comprada (ex.: 50 adesivos, 2,5 kg de açúcar). Até 3 casas decimais.
  quantidade     Decimal         @db.Decimal(12, 3)
  unidade        ExpenseUnit
  /// Quanto foi pago no total, em reais (ex.: 20.00). Custo unitário = valorTotal / quantidade.
  valorTotal     Decimal         @map("valor_total") @db.Decimal(10, 2)
  /// Dia da compra (sem hora).
  data           DateTime        @db.Date
  fornecedor     String?         @db.VarChar(80)
  observacao     String?         @db.VarChar(300)
  createdAt      DateTime        @default(now()) @map("created_at")
  /// Admin que lançou. SetNull: a despesa continua no histórico se a conta for removida.
  criadoPorId    String?         @map("criado_por_id")
  criadoPor      User?           @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  /// Compra de insumo: liga a despesa ao estoque da produção (opcional).
  insumoId       String?         @map("insumo_id")
  /// Quanto entrou no estoque, na unidade do insumo (2,155 kg de maçã → 2155 g).
  quantidadeBase Decimal?        @map("quantidade_base") @db.Decimal(14, 3)
  /// Restrict: insumo com compra não se apaga (desativa).
  insumo         Insumo?         @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([data])
  @@index([criadoPorId])
  @@index([insumoId])
  @@map("expenses")
}

/// Unidade em que o estoque e o custo de um insumo são contados.
enum InsumoUnit {
  G
  ML
  UN
}

/// O que vai dentro do pote (ingrediente) ou o que o embala (pote, tampa, rótulo, lacre).
enum InsumoTipo {
  INGREDIENTE
  EMBALAGEM
}

/// Ingredientes e embalagens da produção (/admin/production). Estoque = compras − usos + ajustes.
model Insumo {
  id              String          @id @default(cuid())
  nome            String          @unique @db.VarChar(80)
  tipo            InsumoTipo
  unidade         InsumoUnit
  /// Avisar quando a sobra ficar abaixo disto (na unidade do insumo).
  estoqueMinimo   Decimal?        @map("estoque_minimo") @db.Decimal(14, 3)
  /// false: não controla estoque (limão do quintal, água): entra na produção com custo informado.
  controlaEstoque Boolean         @default(true) @map("controla_estoque")
  ativo           Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  compras         Expense[]
  usos            ProducaoItem[]
  ajustes         AjusteEstoque[]

  @@map("insumos")
}

/// Um lote de geleia: o que entrou, quanto custou e quantos potes rendeu.
model Producao {
  id          String          @id @default(cuid())
  /// Dia da produção (sem hora).
  data        DateTime        @db.Date
  /// Sabor do catálogo (opcional: receita de teste). Restrict: sabor com produção não se apaga.
  productId   String?         @map("product_id")
  /// Nome da receita/lote (ex.: "Receita 1").
  nome        String          @db.VarChar(80)
  /// Quantos potes renderam.
  potes       Int
  observacao  String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at")
  criadoPorId String?         @map("criado_por_id")
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  criadoPor   User?           @relation("ProducoesRegistradas", fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens       ProducaoItem[]
  custos      ProducaoCusto[]

  @@index([data])
  @@index([productId])
  @@index([criadoPorId])
  @@map("producoes")
}

/// Ingrediente ou embalagem usado num lote.
model ProducaoItem {
  id            String   @id @default(cuid())
  producaoId    String   @map("producao_id")
  insumoId      String   @map("insumo_id")
  /// Quantidade usada, na unidade do insumo.
  quantidade    Decimal  @db.Decimal(14, 3)
  /// R$ por unidade do insumo no dia da produção (custo médio ou o informado): compras depois não mudam o lote.
  custoUnitario Decimal  @map("custo_unitario") @db.Decimal(16, 6)
  producao      Producao @relation(fields: [producaoId], references: [id], onDelete: Cascade)
  insumo        Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([producaoId])
  @@index([insumoId])
  @@map("producao_itens")
}

/// Custo do lote que não é insumo de estoque: gás, energia, água, mão de obra.
model ProducaoCusto {
  id         String   @id @default(cuid())
  producaoId String   @map("producao_id")
  descricao  String   @db.VarChar(60)
  valor      Decimal  @db.Decimal(10, 2)
  producao   Producao @relation(fields: [producaoId], references: [id], onDelete: Cascade)

  @@index([producaoId])
  @@map("producao_custos")
}

/// Correção manual do estoque: perda, estragou, recontagem (positivo entra, negativo sai).
model AjusteEstoque {
  id          String   @id @default(cuid())
  insumoId    String   @map("insumo_id")
  quantidade  Decimal  @db.Decimal(14, 3)
  motivo      String   @db.VarChar(120)
  data        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  criadoPorId String?  @map("criado_por_id")
  insumo      Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  criadoPor   User?    @relation("AjustesRegistrados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([insumoId])
  @@map("ajustes_estoque")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  quantidade    Int
  /// Preço do produto no momento da compra (não muda se o preço do produto mudar depois).
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Kit de presente (caixa com N potes à escolha). Não tem foto: a loja desenha a caixa com as fotos
/// REAIS dos sabores escolhidos (os mockups recebidos têm erros de marca, peso e sabor).
model Kit {
  id              String     @id
  nome            String     @db.VarChar(80)
  descricao       String     @db.VarChar(300)
  /// Preço de UMA caixa, em reais (padrão 40.00). Configurado no painel.
  preco           Decimal    @db.Decimal(10, 2)
  /// Quantos potes vão na caixa (3). Não editável no painel na v1.
  potes           Int        @default(3)
  /// Peso da caixa vazia, somado ao dos potes no frete.
  pesoCaixaGramas Int        @map("peso_caixa_gramas")
  /// Aparece na loja? Nasce oculto: a dona confere o preço e ativa no painel.
  ativo           Boolean    @default(false)
  pedidos         OrderKit[]

  @@map("kits")
}

/// Caixas de um pedido. Mesma composição = uma linha com quantidade > 1.
model OrderKit {
  id            String          @id @default(cuid())
  orderId       String          @map("order_id")
  kitId         String          @map("kit_id")
  /// Quantas caixas com esta composição.
  quantidade    Int
  /// Preço de UMA caixa no momento da compra (congelado: mudar o preço do kit não muda pedidos antigos).
  precoUnitario Decimal         @map("preco_unitario") @db.Decimal(10, 2)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict: kit com vendas não se apaga (oculta-se).
  kit           Kit             @relation(fields: [kitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sabores       OrderKitSabor[]

  @@index([orderId])
  @@index([kitId])
  @@map("order_kits")
}

/// Composição: potes de cada sabor em CADA caixa. Total de potes = quantidade × orderKit.quantidade.
model OrderKitSabor {
  id           String   @id @default(cuid())
  orderKitId   String   @map("order_kit_id")
  productId    String   @map("product_id")
  /// Potes deste sabor em UMA caixa.
  quantidade   Int
  /// Preço avulso do sabor no dia (congelado): base do rateio e do "desconto dado".
  precoAvulso  Decimal  @map("preco_avulso") @db.Decimal(10, 2)
  /// Parte do preço de UMA caixa atribuída a este sabor (todos os potes dele). Soma = precoUnitario.
  valorRateado Decimal  @map("valor_rateado") @db.Decimal(10, 2)
  orderKit     OrderKit @relation(fields: [orderKitId], references: [id], onDelete: Cascade)
  /// Restrict: sabor vendido em kit não se apaga (oculta-se), como na venda avulsa.
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderKitId, productId])
  @@index([productId])
  @@map("order_kit_sabores")
}

/// Configuração da loja editável no painel. Uma linha só (id = 1, CHECK no banco); sem a linha, vale
/// o padrão do código (src/lib/entrega-regras.ts).
model ConfigLoja {
  id                  Int      @id @default(1)
  /// Taxa fixa de entrega em Teresina, em centavos (0 a 10000; CHECK no banco).
  taxaEntregaCentavos Int      @default(1500) @map("taxa_entrega_centavos")
  atualizadoEm        DateTime @default(now()) @updatedAt @map("atualizado_em")
  /// SetNull: a configuração fica se a conta do admin sair.
  atualizadoPorId     String?  @map("atualizado_por_id")
  atualizadoPor       User?    @relation("ConfigLojaAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@index([atualizadoPorId])
  @@map("config_loja")
}

/// Por onde veio o link de redefinição de senha.
enum OrigemRedefinicao {
  EMAIL
  PAINEL
}

/// Pedido de redefinição de senha (por e-mail ou gerado pela dona no painel). Só o hash SHA-256 do
/// token fica aqui; o token vai no fragmento do link (#t=...). Sem IP nem e-mail (LGPD): as linhas
/// com mais de 12 meses são apagadas. Ver src/lib/auth/redefinicao.ts.
model RedefinicaoSenha {
  id           String            @id @default(cuid())
  userId       String            @map("user_id")
  /// sha256(token) em hex (64 caracteres).
  tokenHash    String            @unique @map("token_hash") @db.Char(64)
  origem       OrigemRedefinicao
  criadoEm     DateTime          @default(now()) @map("criado_em")
  expiraEm     DateTime          @map("expira_em")
  usadoEm      DateTime?         @map("usado_em")
  /// Um link novo invalida o anterior.
  invalidadoEm DateTime?         @map("invalidado_em")
  /// PAINEL: admin que gerou e o que conferiu ("EMAIL", "NOME", "PEDIDO", "ENDERECO", "TELEFONE").
  geradoPorId  String?           @map("gerado_por_id")
  conferencia  String[]          @default([])
  observacao   String?           @db.VarChar(200)
  user         User              @relation("RedefinicoesDaConta", fields: [userId], references: [id], onDelete: Cascade)
  geradoPor    User?             @relation("LinksSenhaGerados", fields: [geradoPorId], references: [id], onDelete: SetNull)

  @@index([userId, criadoEm])
  @@index([criadoEm])
  @@index([geradoPorId])
  @@map("redefinicoes_senha")
}

// --- Encomendas de lembrancinhas (potinhos mini de 40 ml) ------------------------------------------
// Entidade própria (não é um `Order`): status, pagamentos em duas parcelas e prazos próprios, sem
// mexer no caminho dos pedidos comuns. Regras puras em src/lib/encomendas-regras.ts.

/// Situação da encomenda. "Quitada" NÃO é status: é `restantePagoEm` preenchido.
/// Finais: ENTREGUE, RECUSADA, EXPIRADA e CANCELADA.
enum EncomendaStatus {
  SOLICITADA
  AGUARDANDO_ENTRADA
  CONFIRMADA
  EM_PRODUCAO
  PRONTA
  ENTREGUE
  RECUSADA
  EXPIRADA
  CANCELADA
}

/// As duas cobranças PIX: a entrada (50% dos potinhos) e o restante (com o frete).
enum ParcelaEncomenda {
  ENTRADA
  RESTANTE
}

/// Quem encerrou a encomenda (desistência da cliente, cancelamento da loja).
enum AtorEncomenda {
  CLIENTE
  LOJA
  SISTEMA
}

enum DevolucaoStatus {
  PENDENTE
  FEITA
}

/// Por que o dinheiro volta para a cliente.
enum DevolucaoMotivo {
  /// A cliente desistiu (valor pela regra do corte e do percentual retido).
  DESISTENCIA
  /// A loja cancelou.
  CANCELAMENTO
  /// PIX pago depois de a encomenda encerrar (recusada, expirada, cancelada).
  PAGAMENTO_TARDIO
  /// A mesma parcela paga duas vezes (dois PIX, ou PIX + registro fora do site).
  PAGAMENTO_DUPLICADO
}

/// Linha única (id "lembrancinhas"). Nasce DESATIVADA, com valores provisórios (decisões D1, D4, D10).
model ConfigLembrancinhas {
  id                  String   @id
  ativo               Boolean  @default(false)
  /// Preço de UM potinho, em reais (único para todos os sabores na v1).
  precoPotinho        Decimal  @map("preco_potinho") @db.Decimal(10, 2)
  /// Peso do potinho cheio (geleia + vidro + tampa), para o frete.
  pesoPotinhoGramas   Int      @map("peso_potinho_gramas")
  /// Peso da embalagem da encomenda inteira, somado ao dos potinhos no frete.
  pesoEmbalagemGramas Int      @default(0) @map("peso_embalagem_gramas")
  /// Quanto da entrada fica com a loja se a cliente desistir DEPOIS do corte (0 a 100; padrão 100,
  /// decisão D4). Congelado em cada encomenda na aprovação.
  percentualRetido    Int      @default(100) @map("percentual_retido")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  @@map("config_lembrancinhas")
}

model Encomenda {
  id                      String               @id @default(cuid())
  userId                  String               @map("user_id")
  status                  EncomendaStatus      @default(SOLICITADA)
  /// Dia da festa e dia da entrega OU retirada (sem hora; o horário é combinado pelo WhatsApp).
  dataFesta               DateTime             @map("data_festa") @db.Date
  dataEntrega             DateTime             @map("data_entrega") @db.Date
  modoEntrega             ModoEntrega          @map("modo_entrega")
  /// Só na ENTREGA (CHECK). Restrict: endereço com encomenda não se apaga.
  addressId               String?              @map("address_id")
  /// Só dígitos, com DDD. Fica só na encomenda (LGPD: finalidade de combinar esta encomenda) e nunca
  /// vai para log.
  telefone                String               @db.VarChar(11)
  observacao              String?              @db.VarChar(300)
  potinhos                Int
  /// Valores congelados na solicitação, em reais. entrada = ⌈subtotal/2⌉; restante = total − entrada.
  subtotal                Decimal              @db.Decimal(10, 2)
  frete                   Decimal              @db.Decimal(10, 2)
  total                   Decimal              @db.Decimal(10, 2)
  valorEntrada            Decimal              @map("valor_entrada") @db.Decimal(10, 2)
  valorRestante           Decimal              @map("valor_restante") @db.Decimal(10, 2)
  pesoTotalGramas         Int                  @map("peso_total_gramas")
  /// Prazos calculados no servidor (src/lib/encomendas-regras.ts): até quando a loja responde, o
  /// corte da desistência (23h59 de 3 dias antes da entrega) e até quando a entrada pode ser paga.
  responderAte            DateTime             @map("responder_ate")
  corteEm                 DateTime             @map("corte_em")
  entradaAte              DateTime?            @map("entrada_ate")
  /// Percentual da entrada que a cliente ACEITOU ao solicitar (o texto da política que ela leu). Nunca muda.
  percentualAceito        Int                  @map("percentual_aceito")
  /// Percentual da entrada retido se a cliente desistir depois do corte: o que vale de fato. Começa igual
  /// ao aceito e, na aprovação, desce se o painel o baixou depois; nunca sobe acima do aceito (CHECK).
  percentualRetido        Int                  @map("percentual_retido")
  politicaVersao          String               @map("politica_versao") @db.VarChar(20)
  politicaAceitaEm        DateTime             @map("politica_aceita_em")
  /// Cabeçalho Idempotency-Key (obrigatório): reenviar a mesma chave devolve esta encomenda.
  idempotencyKey          String               @map("idempotency_key") @db.VarChar(100)
  criadaEm                DateTime             @default(now()) @map("criada_em")
  aprovadaEm              DateTime?            @map("aprovada_em")
  entradaPagaEm           DateTime?            @map("entrada_paga_em")
  /// Entrada recebida fora do site e registrada pela dona (dinheiro, PIX direto), ou dada como recebida
  /// depois de uma conferência que não fechou: forma, observação e quem registrou. Pelo site, tudo
  /// isto fica vazio (a forma está na cobrança, em `pagamentos`).
  entradaForma            PaymentMethod?       @map("entrada_forma")
  entradaForaDoSite       Boolean              @default(false) @map("entrada_fora_do_site")
  entradaObservacao       String?              @map("entrada_observacao") @db.VarChar(300)
  entradaRegistradaPorId  String?              @map("entrada_registrada_por_id")
  producaoIniciadaEm      DateTime?            @map("producao_iniciada_em")
  prontaEm                DateTime?            @map("pronta_em")
  /// Quitação. Pelo site: PIX (`restanteForma` = PIX, `restanteForaDoSite` = false). Fora do site
  /// (decisão D8): a forma informada pela dona, com quem registrou.
  restantePagoEm          DateTime?            @map("restante_pago_em")
  restanteForma           PaymentMethod?       @map("restante_forma")
  restanteForaDoSite      Boolean              @default(false) @map("restante_fora_do_site")
  restanteObservacao      String?              @map("restante_observacao") @db.VarChar(300)
  restanteRegistradoPorId String?              @map("restante_registrado_por_id")
  entregueEm              DateTime?            @map("entregue_em")
  /// Quando foi recusada, expirou ou foi cancelada.
  encerradaEm             DateTime?            @map("encerrada_em")
  motivoRecusa            String?              @map("motivo_recusa") @db.VarChar(300)
  canceladaPor            AtorEncomenda?       @map("cancelada_por")
  motivoCancelamento      String?              @map("motivo_cancelamento") @db.VarChar(300)
  /// Último status avisado à cliente pelo WhatsApp (link do painel) e quando.
  avisadaStatus           EncomendaStatus?     @map("avisada_status")
  avisadaEm               DateTime?            @map("avisada_em")
  user                    User                 @relation("EncomendasDoCliente", fields: [userId], references: [id], onDelete: Restrict)
  address                 Address?             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  restanteRegistradoPor   User?                @relation("RestantesRegistrados", fields: [restanteRegistradoPorId], references: [id], onDelete: SetNull)
  entradaRegistradaPor    User?                @relation("EntradasRegistradas", fields: [entradaRegistradaPorId], references: [id], onDelete: SetNull)
  itens                   EncomendaItem[]
  /// Cobranças da ENTRADA e do RESTANTE (tabela `pagamentos`, a mesma dos pedidos).
  pagamentos              Pagamento[]
  devolucoes              EncomendaDevolucao[]

  @@unique([userId, idempotencyKey])
  @@index([userId, criadaEm])
  @@index([status, dataEntrega])
  @@index([status, responderAte])
  @@index([status, entradaAte])
  @@index([entregueEm])
  @@index([restantePagoEm])
  @@index([addressId])
  @@index([restanteRegistradoPorId])
  @@index([entradaRegistradaPorId])
  @@map("encomendas")
}

/// Potinhos de cada sabor. O sabor é o produto do catálogo marcado "disponível em mini".
model EncomendaItem {
  id            String    @id @default(cuid())
  encomendaId   String    @map("encomenda_id")
  productId     String    @map("product_id")
  quantidade    Int
  /// Preço de UM potinho congelado na solicitação (já permite preço por sabor na etapa 2).
  precoUnitario Decimal   @map("preco_unitario") @db.Decimal(10, 2)
  encomenda     Encomenda @relation(fields: [encomendaId], references: [id], onDelete: Cascade)
  /// Restrict: sabor com encomenda não se apaga (oculta-se), como nos pedidos.
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([encomendaId, productId])
  @@index([productId])
  @@map("encomenda_itens")
}

/// Dinheiro a devolver à cliente. Uma linha por motivo (a desistência, um PIX pago tarde…): o
/// Financeiro tira cada devolução da receita no mês em que ela foi FEITA, e uma devolução nova não
/// muda um mês já fechado. Na v1 a devolução é 100% manual: a dona devolve pelo app da InfinitePay e
/// marca no painel (a InfinitePay não avisa estorno pelo webhook_url).
model EncomendaDevolucao {
  id              String          @id @default(cuid())
  encomendaId     String          @map("encomenda_id")
  /// A cobrança (tabela `pagamentos`) que originou a devolução (paga tarde ou em duplicidade); nula na
  /// desistência e no cancelamento.
  pagamentoId     String?         @map("pagamento_id")
  motivo          DevolucaoMotivo
  valor           Decimal         @db.Decimal(10, 2)
  status          DevolucaoStatus @default(PENDENTE)
  criadaEm        DateTime        @default(now()) @map("criada_em")
  feitaEm         DateTime?       @map("feita_em")
  observacao      String?         @db.VarChar(300)
  /// Quem marcou como feita. SetNull: fica o registro se a conta do admin sair.
  registradaPorId String?         @map("registrada_por_id")
  encomenda       Encomenda       @relation(fields: [encomendaId], references: [id], onDelete: Restrict)
  pagamento       Pagamento?      @relation(fields: [pagamentoId], references: [id], onDelete: Restrict)
  registradaPor   User?           @relation("DevolucoesRegistradas", fields: [registradaPorId], references: [id], onDelete: SetNull)

  @@index([encomendaId])
  @@index([status, feitaEm])
  @@index([pagamentoId])
  @@index([registradaPorId])
  @@map("encomenda_devolucoes")
}
